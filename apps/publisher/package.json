{
  "name": "@offcut/publisher",
  "version": "3.1.0",
  "private": true,
  "description": "OFFCUT AGENT reward publisher - settles each ten-minute period and publishes the cumulative Merkle root to OffcutRewards.",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@offcut/core": "workspace:*",
    "@offcut/rewards": "workspace:*",
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
